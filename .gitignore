# .env is auto-generated by Lovable Cloud and contains only PUBLISHABLE
# identifiers (Supabase URL, publishable/anon key, project id). It must stay
# tracked so production builds can inline VITE_* values. Real secrets live in
# Lovable Cloud secret storage, never here.
.env.local
.env.*.local
