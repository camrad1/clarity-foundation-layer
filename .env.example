# Server-only secrets — never expose to client code or source control
SUPABASE_SERVICE_ROLE_KEY=
WELCOMEHOME_API_TOKEN=
FURTHER_API_KEY=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
